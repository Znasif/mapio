# MapIO local model tiers
# Consumed by: llama serve --models-preset @HOME_DIR@/models.ini
# Keys are llama.cpp long options with the leading "--" stripped.
# Select a tier per-request via the OpenAI "model" field: "l3" or "l1".
#
# Generated by install.sh from packaging/templates/config/models.ini.in.
# Edit the template, not this file, unless you are tuning one machine.

# ---------------------------------------------------------------
# L3 — reasoning, tool loop, narration
# ---------------------------------------------------------------
[l3]
hf-repo           = unsloth/gemma-4-e4b-it-qat-GGUF:UD-Q4_K_XL
ctx-size          = 8192
flash-attn        = on
cache-type-k      = q8_0
cache-type-v      = q8_0
gpu-layers        = 99
parallel          = 1
cache-reuse       = 256
slot-save-path    = @HOME_DIR@/cache/kv

# The mmproj carries both encoders (audio + vision) and is pulled automatically
# alongside the hf-repo. Keeping it off the GPU frees ~0.92 GiB of the Metal
# budget; it runs once per utterance, not once per token. MapIO transcribes
# through the on-device Apple recogniser, so nothing here uses it today.
no-mmproj-offload = true

# Deliberately NOT set: jinja. Without it llama.cpp uses its generic tool
# handler, which is what every graded MapIO run has used. Enabling it made
# LFM2.5 re-issue the same guide_to_point_of_interest call 48 times against a
# valid acknowledgement; it has never been measured as safe for this tier
# either. See ../benchmark/results/lfm2.5-evaluation.md.

# ---------------------------------------------------------------
# L1 — embeddings: place resolution for the curated prompt
# ---------------------------------------------------------------
# Cheap enough to be invisible: one query embedding per turn, ~21 ms warm,
# against turns of 15-60 s. The document index is built once per map and
# cached under @HOME_DIR@/cache, so this tier is idle most of the time and
# the router lets it sleep.
[l1]
hf-repo   = ggml-org/embeddinggemma-300M-GGUF
ctx-size  = 2048
embedding = true
