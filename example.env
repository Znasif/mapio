# ---------------------------------------------------------------------------
# Cloud services (upstream MapIO). Only needed on the paths still using them:
# OPENAI_API_KEY when LLM_BASE_URL is unset, GOOGLE_SPEECH_CLOUD_KEY_FILE when
# STT_BACKEND is "google", GOOGLE_ROUTES_API_KEY for street-by-street routing.
# ---------------------------------------------------------------------------
OPENAI_API_KEY="https://platform.openai.com"
GOOGLE_SPEECH_CLOUD_KEY_FILE="https://console.cloud.google.com/apis/api/speech.googleapis.com"
GOOGLE_ROUTES_API_KEY="https://console.cloud.google.com/google/maps-apis/api-list"

# ---------------------------------------------------------------------------
# Local stack. Setting LLM_BASE_URL is the single switch: it points the client
# at an OpenAI-compatible server AND selects the curated prompt formatter with
# its L1 retrieval step, which is what the benchmark measured. Leave it unset
# and MapIO behaves exactly as upstream.
#
# The Mac is a pure server; mapio runs where the camera is and talks to it.
# Replace localhost with the Mac's address when they are different machines.
# ---------------------------------------------------------------------------
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="l3"
# LLM_EMBED_MODEL="l1"
# LLM_CANDIDATES_K="8"

# Speech-to-text. "apple" is on-device, needs no key, and takes no RAM from the
# llama.cpp budget. STT_SERVER posts the WAV to tools/macos_stt/stt_server.py;
# leave it unset to shell out to a local binary when mapio runs on the Mac.
# STT_BACKEND="apple"
# STT_SERVER="http://localhost:11435"

# Escape hatches, both default correctly from LLM_BASE_URL. Set them only to
# measure upstream behaviour against the local window: re-injecting the full
# instruction block after every tool round, and keeping every past turn's
# scaffolding verbatim, together overflow 8192 tokens by turn 3.
# LLM_REINJECT_INSTRUCTIONS="0"
# LLM_COMPACT_HISTORY="1"

# ---------------------------------------------------------------------------
# Note: --prompt is a command-line flag, not an env var. It defaults to
# res/prompt_<lang>.yaml, which is upstream MapIO's prompt. Local runs should
# pass the prompt the benchmark was run with:
#
#   python mapio.py --model models/new_york/new_york.json \
#                   --prompt res/prompt_en_fixed.yaml
# ---------------------------------------------------------------------------
